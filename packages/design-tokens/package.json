{
  "name": "@cp/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./nativewind": {
      "types": "./dist/nativewind.d.ts",
      "import": "./dist/nativewind.js",
      "require": "./dist/nativewind.cjs"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsx scripts/build-css.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cp/config": "workspace:*",
    "@types/node": "^20.19.0",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
