{
  "name": "car-platform",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@cp/web",
    "dev:mobile": "pnpm --filter @cp/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @cp/api test:integration",
    "test:functions": "deno test --permit-no-files supabase/functions",
    "functions:serve": "supabase functions serve",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "turbo run lint typecheck test && pnpm test:functions && pnpm db:test && pnpm test:integration",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:new": "supabase migration new",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint",
    "db:types": "supabase gen types typescript --local --schema public > packages/types/src/database.ts",
    "db:seed:users": "pnpm --filter @cp/scripts seed:users",
    "db:seed:images": "pnpm --filter @cp/scripts seed:images",
    "db:remote:link": "set -a && . ./.env.remote.local && set +a && supabase link --project-ref \"$SUPABASE_PROJECT_REF\" --password \"$SUPABASE_DB_PASSWORD\"",
    "db:remote:push": "set -a && . ./.env.remote.local && set +a && supabase db push --password \"$SUPABASE_DB_PASSWORD\"",
    "db:seed": "pnpm db:seed:users && pnpm db:seed:images"
  },
  "devDependencies": {
    "@cp/config": "workspace:*",
    "@types/node": "^24.0.0",
    "deno": "^2.9.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.119.0",
    "turbo": "^2.11.6",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "typescript": "6.0.3",
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  }
}
