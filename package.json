{
  "name": "car-platform",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@cp/web",
    "dev:mobile": "pnpm --filter @cp/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "turbo run lint typecheck test"
  },
  "devDependencies": {
    "@cp/config": "workspace:*",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.6",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "typescript": "6.0.3",
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  }
}
